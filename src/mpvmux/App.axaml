<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="mpvmux.App"
             RequestedThemeVariant="Light">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Material.Icons.Avalonia/MaterialIconStyles.axaml" />

        <!-- On Windows the tray menu is an Avalonia popup; keep it compact without
             affecting the in-window menus. -->
        <Style Selector="Window[ShowInTaskbar=false] MenuItem">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="Window[ShowInTaskbar=false] MenuFlyoutPresenter">
            <Setter Property="MinHeight" Value="0" />
        </Style>

    </Application.Styles>
</Application>