<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="mpvmux.App"
             RequestedThemeVariant="Light">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#FFFFFFFF" />
                </ResourceDictionary>
                <!-- Fluent's dark window background is pure black, which reads much darker
                     than a typical desktop dark theme; use a softer near-black instead. -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#FF191919" />

                    <!-- Fluent paints input surfaces with translucent black in dark mode,
                         which collapses to near-black on top of the window background. -->
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FF252525" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF2F2F2F" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FF383838" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#FF3A3A3A" />

                    <SolidColorBrush x:Key="TextControlBackground" Color="#FF252525" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF2F2F2F" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF252525" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FF1F1F1F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Material.Icons.Avalonia/MaterialIconStyles.axaml" />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppWindowBackgroundBrush}" />
        </Style>

        <!-- On Windows the tray menu is an Avalonia popup; keep it compact without
             affecting the in-window menus. -->
        <Style Selector="Window[ShowInTaskbar=false] MenuItem">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="Window[ShowInTaskbar=false] MenuFlyoutPresenter">
            <Setter Property="MinHeight" Value="0" />
        </Style>

    </Application.Styles>
</Application>