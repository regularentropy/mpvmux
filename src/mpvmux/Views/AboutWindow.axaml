<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:mpvmux.ViewModels"
		xmlns:material="using:Material.Icons.Avalonia"
		Width="420"
		SizeToContent="Height"
		CanResize="False"
		x:Class="mpvmux.Views.AboutWindow"
		x:DataType="vm:AboutWindowViewModel"
		Title="About mpvmux"
		Icon="{DynamicResource AppWindowIcon}"
		ShowInTaskbar="False"
		WindowStartupLocation="CenterOwner">

	<Design.DataContext>
		<vm:AboutWindowViewModel />
	</Design.DataContext>

	<StackPanel Margin="24" Spacing="18">
		<Grid ColumnDefinitions="Auto,*">
			<Image Source="{DynamicResource AppLogo}"
				   Width="80"
				   Height="80"
				   Stretch="Uniform" />
			<StackPanel Grid.Column="1"
						Margin="16,0,0,0"
						VerticalAlignment="Center"
						Spacing="4">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<TextBlock Text="{CompiledBinding SoftwareName}"
							   FontSize="20"
							   FontWeight="SemiBold"
							   VerticalAlignment="Center" />
					<Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
							CornerRadius="8"
							Padding="8,2"
							VerticalAlignment="Center">
						<TextBlock Text="{CompiledBinding Version}"
								   FontSize="11"
								   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
					</Border>
				</StackPanel>
				<TextBlock Text="External audio manager for mpv"
						   Classes="secondary"
						   TextWrapping="Wrap" />
			</StackPanel>
		</Grid>

		<Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

		<StackPanel Spacing="10">
			<Grid ColumnDefinitions="*,Auto">
				<Button Classes="link"
						Command="{CompiledBinding OpenRepositoryLinkCommand}"
						ToolTip.Tip="Open the repository in your browser"
						AutomationProperties.Name="Open repository on GitHub"
						VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<material:MaterialIcon Kind="OpenInNew" Width="14" Height="14" />
						<TextBlock Text="Repository on GitHub" />
					</StackPanel>
				</Button>
				<Button Name="CloseButton"
						Grid.Column="1"
						Content="Close"
						MinWidth="80"
						IsDefault="True"
						IsCancel="True"
						Click="CloseButton_OnClick"
						AutomationProperties.Name="Close" />
			</Grid>
			<TextBlock Text="{CompiledBinding Copyright}"
					   Classes="secondary" />
		</StackPanel>
	</StackPanel>

	<Window.Styles>
		<Style Selector="TextBlock.secondary">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
		</Style>

		<Style Selector="Button.link">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
			<Setter Property="TextBlock.TextDecorations" Value="Underline" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>

		<Style Selector="Button.link:pointerover">
			<Setter Property="Background" Value="Transparent" />
		</Style>
	</Window.Styles>

</Window>
