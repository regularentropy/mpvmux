<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:mpvmux.ViewModels"
		xmlns:material="using:Material.Icons.Avalonia"
		mc:Ignorable="d"
		x:Class="mpvmux.Views.SetupWindow"
		x:DataType="vm:SetupWindowViewModel"
		Title="Set up mpv"
		Icon="{DynamicResource AppWindowIcon}"
		Width="560"
		SizeToContent="Height"
		CanResize="False"
		ShowInTaskbar="False"
		WindowStartupLocation="CenterOwner">

	<Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

		<!-- Why this window exists -->
		<Grid Grid.Row="0" ColumnDefinitions="Auto,*">
			<Border Width="44"
					Height="44"
					CornerRadius="22"
					VerticalAlignment="Center"
					Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
				<material:MaterialIcon Width="22"
									  Height="22"
									  Kind="Play"
									  HorizontalAlignment="Center"
									  VerticalAlignment="Center"
									  Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
			</Border>
			<StackPanel Grid.Column="1"
						Margin="14,0,0,0"
						Spacing="4"
						VerticalAlignment="Center">
				<TextBlock Text="Set up mpv"
						   FontSize="18"
						   FontWeight="SemiBold" />
				<TextBlock Classes="secondary"
						   Text="mpvmux uses mpv to play video and audio. mpv is a separate program and is not bundled with mpvmux." />
			</StackPanel>
		</Grid>

		<Border Grid.Row="1"
				Height="1"
				Margin="0,16"
				Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

		<!-- Detection result -->
		<Border Grid.Row="2"
				Margin="0,0,0,16"
				Padding="14,10"
				CornerRadius="6"
				BorderThickness="1"
				BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
				Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
			<StackPanel Spacing="3">
				<TextBlock Text="{CompiledBinding StatusText}"
						   FontWeight="SemiBold"
						   TextWrapping="Wrap"
						   Classes.error="{CompiledBinding IsStatusError}" />
				<TextBlock Text="{CompiledBinding StatusDetail}"
						   Classes="secondary"
						   IsVisible="{CompiledBinding HasStatusDetail}" />
			</StackPanel>
		</Border>

		<!-- Manual location -->
		<StackPanel Grid.Row="3" Spacing="8">
			<TextBlock Text="mpv location" />
			<TextBox Text="{CompiledBinding MpvPath, Mode=TwoWay}"
					 PlaceholderText="Folder that contains mpv.exe, or the executable itself"
					 IsEnabled="{CompiledBinding CanInteract}" />
			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button Content="Choose folder..."
						Command="{CompiledBinding BrowseFolderCommand}"
						IsEnabled="{CompiledBinding CanInteract}" />
				<Button Content="Choose mpv.exe..."
						Command="{CompiledBinding BrowseExecutableCommand}"
						IsEnabled="{CompiledBinding CanInteract}" />
				<Button Content="Check again"
						Command="{CompiledBinding InitializeCommand}"
						IsEnabled="{CompiledBinding CanInteract}" />
			</StackPanel>
			<TextBlock Classes="hint"
					   Text="mpv is verified by running &quot;mpv --version&quot; before the location is saved."
					   TextWrapping="Wrap" />
		</StackPanel>

		<!-- Actions -->
		<Grid Grid.Row="4"
			  Margin="0,20,0,0"
			  ColumnDefinitions="Auto,*,Auto">
			<Button Content="Download mpv"
					Command="{CompiledBinding OpenDownloadPageCommand}"
					IsEnabled="{CompiledBinding CanInteract}" />
			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
				<Button Content="Not now"
						MinWidth="80"
						IsCancel="True"
						Click="NotNowButton_OnClick" />
				<Button Content="Save"
						MinWidth="96"
						Classes="accent"
						IsDefault="True"
						IsEnabled="{CompiledBinding CanInteract}"
						Click="SaveButton_OnClick" />
			</StackPanel>
		</Grid>

	</Grid>

	<Window.Styles>
		<Style Selector="TextBlock.secondary">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>

		<Style Selector="TextBlock.hint">
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
			<Setter Property="FontSize" Value="11" />
		</Style>

		<Style Selector="TextBlock.error">
			<Setter Property="Foreground" Value="#C42B1C" />
		</Style>
	</Window.Styles>

</Window>
