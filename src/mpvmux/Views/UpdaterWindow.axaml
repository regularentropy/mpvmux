<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:mpvmux.ViewModels"
		xmlns:material="using:Material.Icons.Avalonia"
		mc:Ignorable="d"
		x:Class="mpvmux.UpdaterWindow"
		x:DataType="vm:UpdaterViewModel"
		Title="Update available"
		Icon="/Assets/logo.png"
		Width="560"
		Height="470"
		MinWidth="480"
		MinHeight="360"
		ShowInTaskbar="False"
		WindowStartupLocation="CenterOwner">

	<Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto">

		<!-- What is available -->
		<Grid Grid.Row="0" ColumnDefinitions="Auto,*">
			<Border Width="44"
					Height="44"
					CornerRadius="22"
					VerticalAlignment="Center"
					Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
				<material:MaterialIcon Width="22"
									  Height="22"
									  Kind="Download"
									  HorizontalAlignment="Center"
									  VerticalAlignment="Center"
									  Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
			</Border>
			<StackPanel Grid.Column="1"
						Margin="14,0,0,0"
						Spacing="4"
						VerticalAlignment="Center">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<TextBlock Text="{CompiledBinding Heading}"
							   FontSize="18"
							   FontWeight="SemiBold"
							   TextWrapping="Wrap"
							   VerticalAlignment="Center" />
					<Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
							CornerRadius="8"
							Padding="8,2"
							VerticalAlignment="Center">
						<TextBlock Text="{CompiledBinding NewVersion}"
								   FontSize="11"
								   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
					</Border>
				</StackPanel>
				<TextBlock Text="{CompiledBinding VersionSummary}"
						   Classes="secondary" />
			</StackPanel>
		</Grid>

		<Border Grid.Row="1"
				Height="1"
				Margin="0,16"
				Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

		<!-- Release notes -->
		<Grid Grid.Row="2" RowDefinitions="Auto,*">
			<TextBlock Margin="0,0,0,8"
					   Text="What's new"
					   Classes="section" />
			<Border Grid.Row="1"
					CornerRadius="6"
					BorderThickness="1"
					BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
					Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
				<ScrollViewer Padding="14,10">
					<SelectableTextBlock Text="{CompiledBinding ReleaseNotes}"
										 TextWrapping="Wrap"
										 FontSize="13"
										 LineHeight="20" />
				</ScrollViewer>
			</Border>
		</Grid>

		<!-- Actions -->
		<Grid Grid.Row="3"
			  Margin="0,16,0,0"
			  ColumnDefinitions="*,Auto">
			<TextBlock Text="Opens the release page in your browser."
					   Classes="secondary"
					   VerticalAlignment="Center" />
			<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
				<Button Content="Later"
						MinWidth="80"
						IsCancel="True"
						Click="CloseButton_OnClick"
						AutomationProperties.Name="Close without updating" />
				<Button MinWidth="160"
						Classes="accent"
						IsDefault="True"
						Command="{CompiledBinding OpenUpdateLinkCommand}"
						AutomationProperties.Name="Open release page">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<material:MaterialIcon Width="14" Height="14" Kind="OpenInNew" />
						<TextBlock Text="Open release page" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>

	</Grid>

	<Window.Styles>
		<Style Selector="TextBlock.secondary">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>

		<Style Selector="TextBlock.section">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
	</Window.Styles>

</Window>
