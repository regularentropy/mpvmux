<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="using:mpvmux.Controls"
			 xmlns:models="using:mpvmux.Models"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 x:Class="mpvmux.Controls.Selector"
			 x:DataType="local:Selector"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 >
	<DockPanel>
		<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,2,4,6">
			<TextBlock Grid.Column="0"
					   Text="{CompiledBinding RowName, RelativeSource={RelativeSource AncestorType=local:Selector}}"
					   FontSize="14"
					   FontWeight="SemiBold"
					   VerticalAlignment="Center" />
			<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
				<Button Classes="listAction"
						Content="Load folder…"
						ToolTip.Tip="Replace this list with every supported file in a folder"
						Command="{CompiledBinding AddCommand, RelativeSource={RelativeSource AncestorType=local:Selector}}" />
				<Button Classes="listAction"
						Content="Clear"
						ToolTip.Tip="Remove all items from this list"
						Command="{CompiledBinding ClearCommand, RelativeSource={RelativeSource AncestorType=local:Selector}}" />
			</StackPanel>
		</Grid>
		<ListBox
		ItemsSource="{CompiledBinding ItemsSource, RelativeSource={RelativeSource AncestorType=local:Selector}}"
		SelectedIndex="{CompiledBinding RowSelectedIndex, RelativeSource={RelativeSource AncestorType=local:Selector}}"
		KeyDown="OnListKeyDown"
		ScrollViewer.VerticalScrollBarVisibility="Auto">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="models:MediaRecord">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Grid.Column="0"
								   Text="{CompiledBinding Name}"
								   TextTrimming="CharacterEllipsis"
								   VerticalAlignment="Center" />
						<Button Grid.Column="1"
								Classes="rowDelete"
								VerticalAlignment="Center"
								ToolTip.Tip="Remove from this list"
								AutomationProperties.Name="Remove"
								Command="{CompiledBinding RemoveCommand, RelativeSource={RelativeSource AncestorType=local:Selector}}"
								CommandParameter="{Binding}">
							<PathIcon Width="9"
									  Height="9"
									  Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
						</Button>
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</DockPanel>

	<UserControl.Styles>
		<Style Selector="ListBoxItem">
			<Setter Property="Height" Value="30" />
			<Setter Property="MinHeight" Value="30" />
			<Setter Property="Padding" Value="8,2,4,2"></Setter>
			<Setter Property="VerticalAlignment" Value="Center"></Setter>
		</Style>
		<Style Selector="Button.listAction">
			<Setter Property="MinHeight" Value="26" />
			<Setter Property="Padding" Value="8,1" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
		</Style>
		<Style Selector="Button.listAction:pointerover">
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
		</Style>
		<Style Selector="Button.rowDelete">
			<Setter Property="Width" Value="22" />
			<Setter Property="Height" Value="22" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Opacity" Value="0.35" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
		</Style>
		<Style Selector="ListBoxItem:pointerover Button.rowDelete">
			<Setter Property="Opacity" Value="1" />
		</Style>
		<Style Selector="Button.rowDelete:pointerover">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
		</Style>
	</UserControl.Styles>
</UserControl>
