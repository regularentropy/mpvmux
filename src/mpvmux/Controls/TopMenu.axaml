<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="using:mpvmux.Controls"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:mpvmux.ViewModels"
			 xmlns:models="clr-namespace:mpvmux.Models"
			 xmlns:material="using:Material.Icons.Avalonia"
			 x:Class="mpvmux.Controls.TopMenu"
			 x:DataType="vm:TopMenuViewModel">

	<Border Padding="4,2"
			BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
			BorderThickness="0,0,0,1">
		<Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

			<!-- Navigation and the current bundle -->
			<StackPanel Grid.Column="0"
						Orientation="Horizontal"
						Spacing="8"
						Margin="0,0,12,0"
						VerticalAlignment="Center">

				<Menu Height="30" FontSize="14" VerticalAlignment="Center">
					<MenuItem Header="_File">
						<MenuItem Header="_New..." Command="{CompiledBinding FileMenu.NewFileCommand}" InputGesture="{CompiledBinding Shortcuts.NewBundle}" />
						<MenuItem Header="_Open..." Command="{CompiledBinding FileMenu.LoadFileCommand}" InputGesture="{CompiledBinding Shortcuts.OpenBundle}" />
						<MenuItem Header="_Save" Command="{CompiledBinding FileMenu.SaveCommand}" InputGesture="{CompiledBinding Shortcuts.SaveBundle}" />
						<MenuItem Header="Save _As..." Command="{CompiledBinding FileMenu.SaveAsCommand}" InputGesture="{CompiledBinding Shortcuts.SaveBundleAs}" />
						<Separator />
						<MenuItem Header="_Preferences..." Command="{CompiledBinding ShowPreferencesCommand}" />
						<MenuItem Header="Set up _mpv..." Command="{CompiledBinding ShowMpvSetupCommand}" />
						<Separator />
						<MenuItem Header="E_xit" Command="{CompiledBinding ExitCommand}" InputGesture="Alt+F4" />
					</MenuItem>
					<MenuItem Header="_Playback">
						<MenuItem Header="_Play" Command="{CompiledBinding Playback.LaunchMPVCommand}" InputGesture="{CompiledBinding Shortcuts.Play}" />
						<MenuItem Header="_Pause" Command="{CompiledBinding Playback.PauseCommand}" InputGesture="{CompiledBinding Shortcuts.Pause}" />
						<MenuItem Header="_Stop" Command="{CompiledBinding Playback.StopCommand}" InputGesture="{CompiledBinding Shortcuts.Stop}" />
						<Separator />
						<MenuItem Header="Pre_vious track" Command="{CompiledBinding Playback.PreviousTrackCommand}" InputGesture="{CompiledBinding Shortcuts.PreviousTrack}" />
						<MenuItem Header="_Next track" Command="{CompiledBinding Playback.NextTrackCommand}" InputGesture="{CompiledBinding Shortcuts.NextTrack}" />
						<Separator />
						<MenuItem Header="_Autoplay"
								  ToggleType="CheckBox"
								  IsChecked="{CompiledBinding IsAutoplayEnabled, Mode=TwoWay}"
								  InputGesture="{CompiledBinding Shortcuts.ToggleAutoplay}" />
						<MenuItem Header="Start playback in _fullscreen"
								  ToggleType="CheckBox"
								  IsChecked="{CompiledBinding IsFullscreenEnabled, Mode=TwoWay}"
								  InputGesture="{CompiledBinding Shortcuts.ToggleFullscreen}" />
					</MenuItem>
					<MenuItem Header="_Help">
						<MenuItem Header="_Check for Updates..." Command="{CompiledBinding CheckForUpdatesCommand}" InputGesture="{CompiledBinding Shortcuts.CheckForUpdates}" />
						<MenuItem Header="_About mpvmux" Command="{CompiledBinding ShowAboutMenuCommand}" InputGesture="{CompiledBinding Shortcuts.About}" />
					</MenuItem>
				</Menu>

				<Border Width="1"
						Height="18"
						Margin="2,0"
						VerticalAlignment="Center"
						Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

				<StackPanel Orientation="Horizontal"
							Spacing="8"
							VerticalAlignment="Center"
							IsVisible="{CompiledBinding History.IsHistoryExists}">
					<TextBlock Text="Recent"
							   FontSize="14"
							   VerticalAlignment="Center"
							   IsVisible="{CompiledBinding History.HasAvailableEntries}"
							   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
					<DropDownButton x:Name="RecentDropDown"
								    MinWidth="220"
								    MaxWidth="400"
								    MinHeight="30"
								    Padding="8,0,4,0"
								    VerticalAlignment="Center"
								    HorizontalContentAlignment="Left"
								    IsVisible="{CompiledBinding History.HasAvailableEntries}"
								    AutomationProperties.Name="Recent bundles"
								    ToolTip.Tip="Switch to a recent bundle">
						<TextBlock Text="{CompiledBinding History.CurrentBundleName}"
								   VerticalAlignment="Center"
								   TextTrimming="CharacterEllipsis" />
						<DropDownButton.Flyout>
							<Flyout Placement="BottomEdgeAlignedLeft">
								<Grid Width="360" MaxHeight="420" RowDefinitions="Auto,Auto">
									<ListBox Classes="recentList"
											 MaxHeight="360"
											 SelectionMode="Single"
											 ItemsSource="{CompiledBinding History.QuickEntries}"
											 ScrollViewer.VerticalScrollBarVisibility="Auto">
										<ListBox.ItemTemplate>
											<DataTemplate DataType="models:MediaRecord">
												<Grid ColumnDefinitions="*,Auto" MinHeight="30">
													<Button Classes="recentRow"
															Click="OnQuickRowClick"
															ToolTip.Tip="{Binding Path}"
															AutomationProperties.Name="{Binding Name}">
														<Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
															<Border Width="12" Height="12">
																<material:MaterialIcon Width="12"
																					  Height="12"
																					  Kind="Pin"
																					  IsVisible="{Binding IsPinned}"
																					  Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
															</Border>
															<TextBlock Grid.Column="1"
																	   Text="{Binding Name}"
																	   VerticalAlignment="Center"
																	   TextTrimming="CharacterEllipsis" />
														</Grid>
													</Button>
													<Button Grid.Column="1"
															Classes="itemAction"
															Margin="4,0,0,0"
															Click="OnQuickPinClick"
															ToolTip.Tip="Pin or unpin"
															AutomationProperties.Name="Pin or unpin">
														<Grid Width="12" Height="12">
															<material:MaterialIcon Width="12"
																				  Height="12"
																				  Kind="Pin"
																				  IsVisible="{Binding IsPinned}" />
															<material:MaterialIcon Width="12"
																				  Height="12"
																				  Kind="PinOutline"
																				  IsVisible="{Binding !IsPinned}" />
														</Grid>
													</Button>
												</Grid>
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>
									<Button Grid.Row="1"
											Classes="manageRecent"
											Click="OnQuickManageClick"
											AutomationProperties.Name="Manage recent bundles">
										<TextBlock Text="{CompiledBinding History.HistoryCount, StringFormat='Manage recent bundles… ({0})'}" />
									</Button>
								</Grid>
							</Flyout>
						</DropDownButton.Flyout>
					</DropDownButton>
					<Button Classes="icon"
							Command="{CompiledBinding OpenBundleFolderCommand}"
							IsEnabled="{CompiledBinding HasBundleFolder}"
							ToolTip.Tip="Open the bundle's folder"
							AutomationProperties.Name="Open bundle folder">
						<material:MaterialIcon Width="16"
											  Height="16"
											  Kind="FolderOutline" />
					</Button>
					<Button Classes="icon"
							Command="{CompiledBinding ShowRecentBundlesCommand}"
							ToolTip.Tip="Manage recent bundles"
							AutomationProperties.Name="Manage recent bundles">
						<material:MaterialIcon Width="16"
											  Height="16"
											  Kind="FormatListBulleted" />
					</Button>
				</StackPanel>

				<TextBlock Margin="2,0,0,0"
						   VerticalAlignment="Center"
						   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
						   IsVisible="{CompiledBinding !History.IsHistoryExists}"
						   Text="No recent bundles" />
			</StackPanel>

			<!-- Volume and settings -->
			<StackPanel Grid.Column="1"
						Orientation="Horizontal"
						Spacing="8"
						VerticalAlignment="Center">

				<Button Classes="icon"
						Command="{CompiledBinding ToggleMuteCommand}"
						ToolTip.Tip="Mute or unmute"
						AutomationProperties.Name="Mute">
					<Grid Width="16" Height="16">
						<material:MaterialIcon Width="16"
											  Height="16"
											  Kind="VolumeHigh"
											  IsVisible="{CompiledBinding !Session.Bundle.IsMuted}" />
						<material:MaterialIcon Width="16"
											  Height="16"
											  Kind="VolumeOff"
											  IsVisible="{CompiledBinding Session.Bundle.IsMuted}" />
					</Grid>
				</Button>

				<Slider Width="96"
						Minimum="0"
						Maximum="100"
						SmallChange="1"
						LargeChange="10"
						VerticalAlignment="Center"
						AutomationProperties.Name="Volume"
						ToolTip.Tip="Volume (applied when playback starts)"
						Value="{CompiledBinding Session.Bundle.Volume, Mode=TwoWay}" />

				<TextBlock Text="{CompiledBinding Session.Bundle.Volume, StringFormat={}{0}%}"
						   Width="42"
						   TextAlignment="Right"
						   FontFeatures="tnum"
						   VerticalAlignment="Center" />

				<Border Width="1"
						Height="18"
						Margin="2,0"
						VerticalAlignment="Center"
						Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

				<Button Classes="icon"
						Command="{CompiledBinding ToggleThemeCommand}"
						ToolTip.Tip="{CompiledBinding ThemeToggleToolTip}"
						AutomationProperties.Name="{CompiledBinding ThemeToggleToolTip}">
					<Grid Width="16" Height="16">
						<material:MaterialIcon Width="16"
											  Height="16"
											  Kind="WeatherNight"
											  IsVisible="{CompiledBinding !IsDarkTheme}" />
						<material:MaterialIcon Width="16"
											  Height="16"
											  Kind="WeatherSunny"
											  IsVisible="{CompiledBinding IsDarkTheme}" />
					</Grid>
				</Button>

				<Button Classes="icon"
						Command="{CompiledBinding ShowPreferencesCommand}"
						ToolTip.Tip="Preferences"
						AutomationProperties.Name="Preferences">
					<material:MaterialIcon Width="16"
										  Height="16"
										  Kind="Cog" />
				</Button>
			</StackPanel>

		</Grid>
	</Border>

	<UserControl.Styles>
		<Style Selector="MenuItem">
			<Setter Property="FontSize" Value="14" />
		</Style>
		<Style Selector="Button.icon">
			<Setter Property="Width" Value="30" />
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.icon:pointerover">
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
		</Style>
		<Style Selector="Button.recentRow">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="MinHeight" Value="30" />
			<Setter Property="Padding" Value="8,2" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="4" />
		</Style>
		<Style Selector="Button.recentRow:pointerover">
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
		</Style>
		<Style Selector="ListBox.recentList">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="0,2" />
		</Style>
		<Style Selector="ListBox.recentList ListBoxItem">
			<Setter Property="Padding" Value="2,0" />
			<Setter Property="MinHeight" Value="30" />
		</Style>
		<Style Selector="Button.manageRecent">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="Padding" Value="8,7" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0,1,0,0" />
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
			<Setter Property="CornerRadius" Value="0" />
		</Style>
		<Style Selector="Button.manageRecent:pointerover">
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
		</Style>
	</UserControl.Styles>

</UserControl>
