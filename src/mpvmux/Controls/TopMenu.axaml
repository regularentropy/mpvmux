<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="using:mpvmux.Controls"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:mpvmux.ViewModels"
			 xmlns:models="clr-namespace:mpvmux.Models"
			 xmlns:material="using:Material.Icons.Avalonia"
			 x:Class="mpvmux.Controls.TopMenu"
			 x:DataType="vm:TopMenuViewModel">

	<Border Padding="4,2"
			BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
			BorderThickness="0,0,0,1">
		<Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

			<!-- Navigation and the current bundle -->
			<StackPanel Grid.Column="0"
						Orientation="Horizontal"
						Spacing="8"
						Margin="0,0,12,0"
						VerticalAlignment="Center">

				<Menu Height="30" FontSize="14" VerticalAlignment="Center">
					<MenuItem Header="_File">
						<MenuItem Header="_New..." Command="{CompiledBinding FileMenu.NewFileCommand}" InputGesture="{CompiledBinding Shortcuts.NewBundle}" />
						<MenuItem Header="_Open..." Command="{CompiledBinding FileMenu.LoadFileCommand}" InputGesture="{CompiledBinding Shortcuts.OpenBundle}" />
						<MenuItem Header="_Save" Command="{CompiledBinding FileMenu.SaveCommand}" InputGesture="{CompiledBinding Shortcuts.SaveBundle}" />
						<MenuItem Header="Save _As..." Command="{CompiledBinding FileMenu.SaveAsCommand}" InputGesture="{CompiledBinding Shortcuts.SaveBundleAs}" />
						<Separator />
						<MenuItem Header="_Preferences..." Command="{CompiledBinding ShowPreferencesCommand}" />
						<Separator />
						<MenuItem Header="E_xit" Command="{CompiledBinding ExitCommand}" InputGesture="Alt+F4" />
					</MenuItem>
					<MenuItem Header="_Playback">
						<MenuItem Header="_Play" Command="{CompiledBinding Playback.LaunchMPVCommand}" InputGesture="{CompiledBinding Shortcuts.Play}" />
						<MenuItem Header="_Pause" Command="{CompiledBinding Playback.PauseCommand}" InputGesture="{CompiledBinding Shortcuts.Pause}" />
						<MenuItem Header="_Stop" Command="{CompiledBinding Playback.StopCommand}" InputGesture="{CompiledBinding Shortcuts.Stop}" />
						<Separator />
						<MenuItem Header="Pre_vious track" Command="{CompiledBinding Playback.PreviousTrackCommand}" InputGesture="{CompiledBinding Shortcuts.PreviousTrack}" />
						<MenuItem Header="_Next track" Command="{CompiledBinding Playback.NextTrackCommand}" InputGesture="{CompiledBinding Shortcuts.NextTrack}" />
						<Separator />
						<MenuItem Header="_Autoplay"
								  ToggleType="CheckBox"
								  IsChecked="{CompiledBinding IsAutoplayEnabled, Mode=TwoWay}"
								  InputGesture="{CompiledBinding Shortcuts.ToggleAutoplay}" />
						<MenuItem Header="Start playback in _fullscreen"
								  ToggleType="CheckBox"
								  IsChecked="{CompiledBinding IsFullscreenEnabled, Mode=TwoWay}"
								  InputGesture="{CompiledBinding Shortcuts.ToggleFullscreen}" />
					</MenuItem>
					<MenuItem Header="_Help">
						<MenuItem Header="_Check for Updates..." Command="{CompiledBinding CheckForUpdatesCommand}" InputGesture="{CompiledBinding Shortcuts.CheckForUpdates}" />
						<MenuItem Header="_About mpvmux" Command="{CompiledBinding ShowAboutMenuCommand}" InputGesture="{CompiledBinding Shortcuts.About}" />
					</MenuItem>
				</Menu>

				<Border Width="1"
						Height="18"
						Margin="2,0"
						VerticalAlignment="Center"
						Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

				<StackPanel Orientation="Horizontal"
							Spacing="8"
							VerticalAlignment="Center"
							IsVisible="{CompiledBinding History.IsHistoryExists}">
					<TextBlock Text="Recent"
							   FontSize="14"
							   VerticalAlignment="Center"
							   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
					<ComboBox MinWidth="220"
							  MaxWidth="400"
							  MinHeight="30"
							  Padding="8,0,0,0"
							  VerticalAlignment="Center"
							  FontWeight="Normal"
							  PlaceholderText="Select a bundle"
							  AutomationProperties.Name="Recent bundles"
							  ToolTip.Tip="Switch to a recent bundle"
							  ItemsSource="{CompiledBinding History.Entries}"
							  SelectedIndex="{CompiledBinding History.SelectedIndex}">
						<ComboBox.ItemContainerTheme>
							<ControlTheme TargetType="ComboBoxItem"
										  BasedOn="{StaticResource {x:Type ComboBoxItem}}">
								<Setter Property="MinHeight" Value="28" />
								<Setter Property="Padding" Value="8,2" />
							</ControlTheme>
						</ComboBox.ItemContainerTheme>
						<ComboBox.SelectionBoxItemTemplate>
							<DataTemplate DataType="models:MediaRecord">
								<TextBlock Text="{CompiledBinding Name}"
										   VerticalAlignment="Center"
										   TextTrimming="CharacterEllipsis" />
							</DataTemplate>
						</ComboBox.SelectionBoxItemTemplate>
						<ComboBox.ItemTemplate>
							<DataTemplate DataType="models:MediaRecord">
								<Grid ColumnDefinitions="*,Auto" MinWidth="160">
									<TextBlock Grid.Column="0"
											   Text="{CompiledBinding Name}"
											   VerticalAlignment="Center"
											   TextTrimming="CharacterEllipsis"
											   ToolTip.Tip="{CompiledBinding Path}" />
									<Button Grid.Column="1"
											Classes="delete"
											Margin="8,0,0,0"
											Command="{Binding $parent[ComboBox].((vm:TopMenuViewModel)DataContext).History.DeleteHistoryRecordCommand}"
											CommandParameter="{Binding}"
											ToolTip.Tip="Remove from recent"
											AutomationProperties.Name="Remove from recent">
										<material:MaterialIcon Width="10"
															  Height="10"
															  Kind="Close" />
									</Button>
								</Grid>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<Button Classes="icon"
							Command="{CompiledBinding OpenBundleFolderCommand}"
							IsEnabled="{CompiledBinding HasBundleFolder}"
							ToolTip.Tip="Open the bundle's folder"
							AutomationProperties.Name="Open bundle folder">
						<material:MaterialIcon Width="16"
											  Height="16"
											  Kind="FolderOutline" />
					</Button>
				</StackPanel>

				<TextBlock Margin="2,0,0,0"
						   VerticalAlignment="Center"
						   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
						   IsVisible="{CompiledBinding !History.IsHistoryExists}"
						   Text="No recent bundles" />
			</StackPanel>

			<!-- Volume and settings -->
			<StackPanel Grid.Column="1"
						Orientation="Horizontal"
						Spacing="8"
						VerticalAlignment="Center">

				<Button Classes="icon"
						Command="{CompiledBinding ToggleMuteCommand}"
						ToolTip.Tip="Mute or unmute"
						AutomationProperties.Name="Mute">
					<Grid Width="16" Height="16">
						<material:MaterialIcon Width="16"
											  Height="16"
											  Kind="VolumeHigh"
											  IsVisible="{CompiledBinding !Session.Bundle.IsMuted}" />
						<material:MaterialIcon Width="16"
											  Height="16"
											  Kind="VolumeOff"
											  IsVisible="{CompiledBinding Session.Bundle.IsMuted}" />
					</Grid>
				</Button>

				<Slider Width="96"
						Minimum="0"
						Maximum="100"
						SmallChange="1"
						LargeChange="10"
						VerticalAlignment="Center"
						AutomationProperties.Name="Volume"
						ToolTip.Tip="Volume (applied when playback starts)"
						Value="{CompiledBinding Session.Bundle.Volume, Mode=TwoWay}" />

				<TextBlock Text="{CompiledBinding Session.Bundle.Volume, StringFormat={}{0}%}"
						   Width="42"
						   TextAlignment="Right"
						   FontFeatures="tnum"
						   VerticalAlignment="Center" />

				<Border Width="1"
						Height="18"
						Margin="2,0"
						VerticalAlignment="Center"
						Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

				<Button Classes="icon"
						Command="{CompiledBinding ToggleThemeCommand}"
						ToolTip.Tip="{CompiledBinding ThemeToggleToolTip}"
						AutomationProperties.Name="{CompiledBinding ThemeToggleToolTip}">
					<Grid Width="16" Height="16">
						<material:MaterialIcon Width="16"
											  Height="16"
											  Kind="WeatherNight"
											  IsVisible="{CompiledBinding !IsDarkTheme}" />
						<material:MaterialIcon Width="16"
											  Height="16"
											  Kind="WeatherSunny"
											  IsVisible="{CompiledBinding IsDarkTheme}" />
					</Grid>
				</Button>

				<Button Classes="icon"
						Command="{CompiledBinding ShowPreferencesCommand}"
						ToolTip.Tip="Preferences"
						AutomationProperties.Name="Preferences">
					<material:MaterialIcon Width="16"
										  Height="16"
										  Kind="Cog" />
				</Button>
			</StackPanel>

		</Grid>
	</Border>

	<UserControl.Styles>
		<Style Selector="MenuItem">
			<Setter Property="FontSize" Value="14" />
		</Style>
		<Style Selector="Button.icon">
			<Setter Property="Width" Value="30" />
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.icon:pointerover">
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
		</Style>
		<Style Selector="Button.delete">
			<Setter Property="Width" Value="24" />
			<Setter Property="Height" Value="24" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Opacity" Value="0.7" />
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
		</Style>
		<Style Selector="Button.delete:pointerover">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
		</Style>
	</UserControl.Styles>

</UserControl>
