<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:vm="using:mpvmux.ViewModels"
			 xmlns:material="using:Material.Icons.Avalonia"
			 x:Class="mpvmux.Controls.BottomPanel"
			 x:DataType="vm:BottomPanelViewModel"
			 >
	<Border Padding="10,8"
			BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
			BorderThickness="0,1,0,0">
		<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
			<Button Grid.Column="0"
					Classes="accent"
					MinWidth="104"
					Command="{CompiledBinding LaunchMPVCommand}"
					IsVisible="{CompiledBinding !IsPlaying}"
					AutomationProperties.Name="Play">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<material:MaterialIcon Width="12" Height="12" Kind="Play" />
					<TextBlock Text="Play" VerticalAlignment="Center" />
				</StackPanel>
			</Button>

			<Button Grid.Column="0"
					Classes="stop"
					MinWidth="104"
					Command="{CompiledBinding StopCommand}"
					IsVisible="{CompiledBinding IsPlaying}"
					AutomationProperties.Name="Stop">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<material:MaterialIcon Width="12" Height="12" Kind="Stop" />
					<TextBlock Text="Stop" VerticalAlignment="Center" />
				</StackPanel>
			</Button>

			<TextBlock Grid.Column="1"
					   Margin="14,0,0,0"
					   FontFeatures="tnum"
					   VerticalAlignment="Center"
					   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
					   Text="{CompiledBinding PlaybackPosition}" />

			<TextBlock Grid.Column="3"
					   Margin="12,0,0,0"
					   FontSize="13"
					   TextTrimming="CharacterEllipsis"
					   VerticalAlignment="Center"
					   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
					   Text="{CompiledBinding PlaybackHint}" />
			<StackPanel Grid.Column="4"
						Orientation="Horizontal"
						Spacing="8"
						Margin="12,0,0,0"
						VerticalAlignment="Center">
				<material:MaterialIcon Width="14"
									  Height="14"
									  Kind="SkipNext"
									  Background="Transparent"
									  IsVisible="{CompiledBinding IsAutoplayEnabled}"
									  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
									  ToolTip.Tip="Advance to the next video when playback ends"
									  AutomationProperties.Name="Advance to the next video when playback ends" />
				<material:MaterialIcon Width="14"
									  Height="14"
									  Kind="Fullscreen"
									  Background="Transparent"
									  IsVisible="{CompiledBinding IsFullscreenEnabled}"
									  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
									  ToolTip.Tip="Start playback in fullscreen"
									  AutomationProperties.Name="Start playback in fullscreen" />
			</StackPanel>
		</Grid>
	</Border>

	<UserControl.Styles>
		<Style Selector="Button">
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="CornerRadius" Value="6" />
		</Style>
		<Style Selector="Button.stop">
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
		</Style>
	</UserControl.Styles>
</UserControl>
