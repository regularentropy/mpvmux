<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:mpvmux.ViewModels"
			 xmlns:material="using:Material.Icons.Avalonia"
			 x:Class="mpvmux.Controls.TrackTable"
			 x:DataType="vm:TrackTableViewModel"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
	<Grid x:Name="RootGrid" RowDefinitions="Auto,*" Margin="5">
		<Grid Grid.Row="0" ColumnDefinitions="*,*,*" Margin="0,0,0,4">
			<Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto" Margin="6,0,6,0">
				<TextBlock Grid.Column="0"
						   Text="Video"
						   FontSize="14"
						   FontWeight="SemiBold"
						   VerticalAlignment="Center" />
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
					<Button Classes="listAction"
							Content="Load folder…"
							ToolTip.Tip="Replace the video list with every supported file in a folder"
							Command="{CompiledBinding LoadVideoCommand}" />
					<Button Classes="listAction"
							Content="Clear"
							ToolTip.Tip="Remove all videos"
							Command="{CompiledBinding ClearVideoCommand}" />
				</StackPanel>
			</Grid>
			<Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" Margin="10,0,6,0">
				<TextBlock Grid.Column="0"
						   Text="Audio"
						   FontSize="14"
						   FontWeight="SemiBold"
						   VerticalAlignment="Center" />
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
					<Button Classes="listAction"
							Content="Load folder…"
							ToolTip.Tip="Replace the audio list with every supported file in a folder"
							Command="{CompiledBinding LoadAudioCommand}" />
					<Button Classes="listAction"
							Content="Clear"
							ToolTip.Tip="Remove all audio tracks"
							Command="{CompiledBinding ClearAudioCommand}" />
				</StackPanel>
			</Grid>
			<Grid Grid.Column="2" ColumnDefinitions="Auto,*,Auto" Margin="10,0,6,0">
				<TextBlock Grid.Column="0"
						   Text="Subtitle"
						   FontSize="14"
						   FontWeight="SemiBold"
						   VerticalAlignment="Center" />
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
					<Button Classes="listAction"
							Content="Load folder…"
							ToolTip.Tip="Replace the subtitle list with every supported file in a folder"
							Command="{CompiledBinding LoadSubtitleCommand}" />
					<Button Classes="listAction"
							Content="Clear"
							ToolTip.Tip="Remove all subtitles"
							Command="{CompiledBinding ClearSubtitlesCommand}" />
				</StackPanel>
			</Grid>
		</Grid>

		<Panel Grid.Row="1">
			<ListBox ItemsSource="{CompiledBinding Rows}"
					 SelectedIndex="{CompiledBinding SelectedRowIndex, Mode=TwoWay}"
					 KeyDown="OnListKeyDown"
					 ScrollViewer.VerticalScrollBarVisibility="Auto">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="vm:TrackRow">
						<Grid ColumnDefinitions="*,*,*" Classes.orphan="{CompiledBinding !IsPlayable}">
							<Border Grid.Column="0" Classes="cell" ToolTip.Tip="{CompiledBinding VideoToolTip}">
								<Grid ColumnDefinitions="*,Auto,Auto">
									<TextBlock Grid.Column="0"
											   Text="{CompiledBinding VideoName}"											   TextTrimming="CharacterEllipsis"
											   VerticalAlignment="Center" />
									<Button Grid.Column="1"
											Classes="cellAction"
											ToolTip.Tip="Replace this video (or set one for this row)"
											Command="{CompiledBinding ReplaceVideoCommand}"
											CommandParameter="{Binding}">
										<material:MaterialIcon Width="9" Height="9" Kind="Pencil" />
									</Button>
									<Button Grid.Column="2"
											Classes="rowDelete"
											IsVisible="{CompiledBinding HasVideo}"
											ToolTip.Tip="Remove this row"
											AutomationProperties.Name="Remove video row"
											Command="{CompiledBinding RemoveVideoCommand}"
											CommandParameter="{Binding}">
										<material:MaterialIcon Width="9" Height="9" Kind="Close" />
									</Button>
								</Grid>
							</Border>

							<Border Grid.Column="1" Classes="cell cellDivider" ToolTip.Tip="{CompiledBinding AudioToolTip}">
								<Grid ColumnDefinitions="*,Auto,Auto">
									<TextBlock Grid.Column="0"
											   Text="{CompiledBinding AudioName}"
											   TextTrimming="CharacterEllipsis"
											   VerticalAlignment="Center" />
									<Button Grid.Column="1"
											Classes="cellAction"
											ToolTip.Tip="Replace this audio track"
											Command="{CompiledBinding ReplaceAudioCommand}"
											CommandParameter="{Binding}">
										<material:MaterialIcon Width="9" Height="9" Kind="Pencil" />
									</Button>
									<Button Grid.Column="2"
											Classes="rowDelete"
											IsVisible="{CompiledBinding HasAudio}"
											ToolTip.Tip="Remove this audio track"
											AutomationProperties.Name="Remove audio track"
											Command="{CompiledBinding RemoveAudioCommand}"
											CommandParameter="{Binding}">
										<material:MaterialIcon Width="9" Height="9" Kind="Close" />
									</Button>
								</Grid>
							</Border>

							<Border Grid.Column="2" Classes="cell cellDivider" ToolTip.Tip="{CompiledBinding SubtitleToolTip}">
								<Grid ColumnDefinitions="*,Auto,Auto">
									<TextBlock Grid.Column="0"
											   Text="{CompiledBinding SubtitleName}"
											   TextTrimming="CharacterEllipsis"
											   VerticalAlignment="Center" />
									<Button Grid.Column="1"
											Classes="cellAction"
											ToolTip.Tip="Replace this subtitle"
											Command="{CompiledBinding ReplaceSubtitleCommand}"
											CommandParameter="{Binding}">
										<material:MaterialIcon Width="9" Height="9" Kind="Pencil" />
									</Button>
									<Button Grid.Column="2"
											Classes="rowDelete"
											IsVisible="{CompiledBinding HasSubtitle}"
											ToolTip.Tip="Remove this subtitle"
											AutomationProperties.Name="Remove subtitle"
											Command="{CompiledBinding RemoveSubtitleCommand}"
											CommandParameter="{Binding}">
										<material:MaterialIcon Width="9" Height="9" Kind="Close" />
									</Button>
								</Grid>
							</Border>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<StackPanel IsVisible="{CompiledBinding !HasRows}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Spacing="8">
				<material:MaterialIcon Kind="FolderArrowDownOutline"
									   Width="40"
									   Height="40"
									   HorizontalAlignment="Center"
									   Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
				<TextBlock Text="Drag a video folder here or use Load folder to begin."
						   TextAlignment="Center"
						   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
			</StackPanel>

			<!-- Shown only while dragging; never intercepts the mouse so the list underneath stays usable. -->
			<Grid IsHitTestVisible="False" ColumnDefinitions="*,*,*">
				<Border x:Name="VideoDropOverlay" Grid.Column="0" Classes="dropTarget" IsVisible="False">
					<Border Classes="dropTint" />
				</Border>
				<Border x:Name="AudioDropOverlay" Grid.Column="1" Classes="dropTarget" IsVisible="False">
					<Border Classes="dropTint" />
				</Border>
				<Border x:Name="SubtitleDropOverlay" Grid.Column="2" Classes="dropTarget" IsVisible="False">
					<Border Classes="dropTint" />
				</Border>
			</Grid>
		</Panel>
	</Grid>

	<UserControl.Styles>
		<Style Selector="Border.dropTarget">
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="CornerRadius" Value="4" />
		</Style>
		<Style Selector="Border.dropTint">
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
			<Setter Property="Opacity" Value="0.12" />
			<Setter Property="CornerRadius" Value="2" />
		</Style>
		<Style Selector="ListBoxItem">
			<Setter Property="Height" Value="32" />
			<Setter Property="MinHeight" Value="32" />
			<Setter Property="Padding" Value="8,2,4,2" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="Border.cell">
			<Setter Property="Padding" Value="4,0" />
		</Style>
		<Style Selector="Border.cellDivider">
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
			<Setter Property="BorderThickness" Value="1,0,0,0" />
			<Setter Property="Padding" Value="8,0" />
		</Style>
		<Style Selector="Grid.orphan TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
		</Style>
		<Style Selector="Button.listAction">
			<Setter Property="MinHeight" Value="26" />
			<Setter Property="Padding" Value="8,1" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
		</Style>
		<Style Selector="Button.listAction:pointerover">
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
		</Style>
		<Style Selector="Button.cellAction">
			<Setter Property="Width" Value="22" />
			<Setter Property="Height" Value="22" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Opacity" Value="0.25" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
		</Style>
		<Style Selector="ListBoxItem:pointerover Button.cellAction">
			<Setter Property="Opacity" Value="0.8" />
		</Style>
		<Style Selector="Button.cellAction:pointerover">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
		</Style>
		<Style Selector="Button.rowDelete">
			<Setter Property="Width" Value="22" />
			<Setter Property="Height" Value="22" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Opacity" Value="0.35" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
		</Style>
		<Style Selector="ListBoxItem:pointerover Button.rowDelete">
			<Setter Property="Opacity" Value="1" />
		</Style>
		<Style Selector="Button.rowDelete:pointerover">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
		</Style>
	</UserControl.Styles>
</UserControl>
