<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="using:mpvmux.Controls"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:mpvmux.ViewModels"
			 x:Class="mpvmux.Controls.TopMenu"
			 x:DataType="vm:TopMenuViewModel">

	<Design.DataContext>
		<vm:TopMenuViewModel/>
	</Design.DataContext>

	<Grid ColumnDefinitions="Auto,*, Auto, Auto, Auto, Auto">
		<DockPanel FlowDirection="LeftToRight" HorizontalSpacing="10">
			<Menu DockPanel.Dock="Left">
				<MenuItem Header="_File">
					<MenuItem Header="_New..." Command="{CompiledBinding NewFileCommand}" InputGesture="Ctrl+N" />
					<MenuItem Header="_Open..." Command="{CompiledBinding LoadFileCommand}" InputGesture="Ctrl+O" />
					<MenuItem Header="_Save..." Command="{CompiledBinding SaveCommand}" InputGesture="Ctrl+S" />
					<MenuItem Header="_Save As..." Command="{CompiledBinding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
					<Separator />
					<MenuItem Header="_Exit" Command="{CompiledBinding ExitCommand}" InputGesture="Alt+F4" />
				</MenuItem>
				<MenuItem Header="Help">
					<MenuItem Header="Check Updates" Command="{CompiledBinding CheckForUpdatesCommand}" InputGesture="F5" />
					<MenuItem Header="About" Command="{CompiledBinding ShowAboutMenuCommand}" InputGesture="F1" />
				</MenuItem>
			</Menu>
			<TextBlock VerticalAlignment="Center" IsVisible="{CompiledBinding !IsHistoryExists}" Text="Add new file to initialize history"></TextBlock>
			<ComboBox VerticalAlignment="Center" IsVisible="{CompiledBinding IsHistoryExists}" ItemsSource="{CompiledBinding HistoryModel.History}" Name="SelectorBox" SelectedIndex="{CompiledBinding SelectedIndex}" SelectedItem="{CompiledBinding SelectedItem}" >
				<ComboBox.SelectionBoxItemTemplate>
					<DataTemplate>
						<TextBlock Text="{CompiledBinding Name}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
					</DataTemplate>
				</ComboBox.SelectionBoxItemTemplate>
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Grid.Column="0" Text="{CompiledBinding Name}" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
							<Button Grid.Column="1"
									Content="x"
									Margin="30,0,0,0"
									Padding="4,0"
									Width="30"
									Height="20"
									FontSize="11"
									HorizontalContentAlignment="Center"
									VerticalContentAlignment="Center"
									Command="{Binding $parent[UserControl].((vm:TopMenuViewModel)DataContext).DeleteHistoryRecordCommand}"
									CommandParameter="{Binding}"
									ToolTip.Tip="Delete from history"/>
						</Grid>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</DockPanel>
		<CheckBox IsChecked="{CompiledBinding ConfigModel.EnableAutomaticPlayback}"  Grid.Column="3" Content="Auto Play" VerticalAlignment="Center" Margin="0,0,10,0"/>
		<CheckBox IsChecked="{CompiledBinding ConfigModel.EnableFullscreen}"  Grid.Column="4" Content="Enable Fullscreen" VerticalAlignment="Center" Margin="0,0,10,0"/>

		<Button Grid.Column="5"
				Padding="8"
				VerticalAlignment="Center">

			<StackPanel Orientation="Horizontal" Spacing="6">
				<TextBlock Text="Volume" VerticalAlignment="Center" />
				<TextBlock Text="{CompiledBinding Volume, StringFormat={}{0:F0}}"
						   Width="26"
						   TextAlignment="Right"
						   FontFeatures="tnum"
						   VerticalAlignment="Center" />
			</StackPanel>

			<Button.Flyout>
				<Flyout Placement="Bottom"
						ShowMode="Transient"
						HorizontalOffset="-10"
						FlyoutPresenterClasses="volume">
					<StackPanel Spacing="6"
								Width="44"
								HorizontalAlignment="Center">
						<Slider Orientation="Vertical"
								Minimum="0"
								Maximum="100"
								Height="180"
								Width="44"
								HorizontalAlignment="Center"
								TickFrequency="5"
								IsSnapToTickEnabled="True"
								Value="{CompiledBinding Volume}" />
						<TextBlock Text="{CompiledBinding Volume, StringFormat={}{0:F0}}"
								   HorizontalAlignment="Center"
								   FontSize="11" />
					</StackPanel>
				</Flyout>
			</Button.Flyout>
		</Button>


	</Grid>
</UserControl>